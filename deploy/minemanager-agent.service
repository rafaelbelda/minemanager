# MineManager agent — the only MineManager daemon that touches Minecraft servers.
#
# Notes:
# systemd supervises the agent (auto-restart, start-on-boot); the agent in turn
# supervises the Minecraft servers/proxies in their own tmux sessions.
# Do NOT create per-server systemd units.
# 
# If this machine ALSO runs the hub, install minemanager-hub.service too. See deploy/README.md
#
# Install:
#   sudo cp deploy/minemanager-agent.service /etc/systemd/system/
#   sudoedit /etc/systemd/system/minemanager-agent.service   # set User + ReadWritePaths
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now minemanager-agent
#
# First enrollment: put the one-time token from the hub UI into the
# EnvironmentFile as MM_ENROLL_TOKEN, start once, then remove it (the agent
# persists the long-lived credential to identity.json and no longer needs it).

[Unit]
Description=MineManager agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Run as the unprivileged minemanager-agent user (NOT root). The agent spawns servers
# as its own children under this user — no sudo/polkit needed.
User=minemanager-agent
Group=minemanager-agent

# MM_HUB_URL, MM_AGENT_DATA_DIR, MM_ENROLL_TOKEN (first run only), etc.
# Keep it root:root 0600; the servers run as this unit's user.
EnvironmentFile=/etc/minemanager/agent.env

ExecStart=/opt/minemanager/venv/bin/minemanager-agent
Restart=always
RestartSec=3

KillMode=mixed
TimeoutStopSec=300

# --- Hardening -------------------------------------------------------------
# Also confines the servers. No MemoryDenyWriteExecute (JVM JIT) or
# ProcSubset=pid (Java reads /proc/meminfo).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
ProtectProc=invisible

# Shared /tmp, so `sudo -u minemanager-agent tmux -L minemanager attach` from a
# login shell finds the same socket the agent created.
PrivateTmp=false

# ProtectSystem=strict makes the whole filesystem read-only, /tmp included, so
# list everything the agent and its servers write to:
#   - the agent's state dir and every directory your servers live in
#   - /tmp: tmux's socket dir (/tmp/tmux-<uid>), and the JVM's java.io.tmpdir,
#     where Netty, sqlite-jdbc and many plugins unpack native libraries
#   - /var/tmp: some plugins and tools use it as a larger scratch space
#
# NOTE: this is also the boundary that limits the damage from an over-broad
# instance root_dir. Keep it as narrow as your layout allows.
ReadWritePaths=/var/lib/minemanager-agent /srv/minecraft /tmp /var/tmp

[Install]
WantedBy=multi-user.target
