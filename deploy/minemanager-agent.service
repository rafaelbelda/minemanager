# MineManager agent — the only MineManager daemon that touches Minecraft servers.
#
# Notes:
# systemd supervises the agent (auto-restart, start-on-boot); the agent in turn
# supervises the Minecraft servers/proxies in their own tmux sessions.
# Do NOT create per-server systemd units.
# 
# If this machine ALSO runs the hub, install minemanager-hub.service too. See deploy/README.md
#
# Install:
#   sudo cp deploy/minemanager-agent.service /etc/systemd/system/
#   sudoedit /etc/systemd/system/minemanager-agent.service   # set User + ReadWritePaths
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now minemanager-agent
#
# First enrollment: put the one-time token from the hub UI into the
# EnvironmentFile as MM_ENROLL_TOKEN, start once, then remove it (the agent
# persists the long-lived credential to identity.json and no longer needs it).

[Unit]
Description=MineManager agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Run as the unprivileged minemanager-agent user (NOT root). The agent spawns servers
# as its own children under this user — no sudo/polkit needed.
User=minemanager-agent
Group=minemanager-agent

# MM_HUB_URL, MM_AGENT_DATA_DIR, MM_ENROLL_TOKEN (first run only), etc.
# Read by systemd as root; keep it root:root 0600 (the servers run as this
# unit's user and must not read it).
EnvironmentFile=/etc/minemanager/agent.env

ExecStart=/opt/minemanager/venv/bin/minemanager-agent
Restart=always
RestartSec=3

KillMode=mixed
TimeoutStopSec=300

# --- Hardening -------------------------------------------------------------
# Everything here also confines the Minecraft servers, which are this unit's
# children. Check with: systemd-analyze security minemanager-agent
#
# Deliberately absent: MemoryDenyWriteExecute (breaks the JVM's JIT) and
# ProcSubset=pid (Java reads /proc/meminfo and /proc/cpuinfo).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
# No capabilities at all: the agent and its servers need none.
CapabilityBoundingSet=
AmbientCapabilities=
# /dev with only the pseudo devices (null, urandom, the pty subsystem tmux uses).
PrivateDevices=true
# Other users' processes (the hub, on a shared box) are invisible to plugins.
ProtectProc=invisible

# PrivateTmp MUST stay off. tmux's socket lives under /tmp.
PrivateTmp=false

# The hardening above makes the whole filesystem read-only, so
# without this the agent cannot write its own data dir, let alone a world.
# List the agent's state dir plus every directory your servers live in.
#
# NOTE: this is also the boundary that limits the damage from an over-broad
# instance root_dir. Keep it as narrow as your layout allows.
ReadWritePaths=/var/lib/minemanager-agent /srv/minecraft

[Install]
WantedBy=multi-user.target
