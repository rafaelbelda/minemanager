# MineManager Hub — Caddy reverse proxy with Authelia in front.
#
# Caddy's defaults already suit large transfers: it does not buffer request or
# response bodies to disk, imposes no body-size limit, and sets no read/write
# timeout. Do not add `request_body max_size` or a transport `read_timeout` —
# either one breaks multi-GB uploads.
#
# This file is the access control. Agent paths bypass Authelia (agents use
# their node credential); everything else gets Authelia, then the proxy secret.
#
# MM_PROXY_SECRET comes from Caddy's environment: `sudo systemctl edit caddy`,
# add `[Service]` / `EnvironmentFile=/etc/minemanager/proxy.env`.

minemanager.example.internal {          # must match MM_ALLOWED_HOSTS
	@agent path /ws/agent /api/internal/transfer/*
	handle @agent {
		reverse_proxy 127.0.0.1:8730 {
			header_up -X-MineManager-Proxy-Secret
		}
	}

	handle {
		# `route` keeps this order: drop client-sent identity headers first.
		route {
			request_header -Remote-User
			request_header -Remote-Groups
			request_header -Remote-Email
			request_header -Remote-Name

			forward_auth authelia:9091 {
				uri /api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
			}

			# Never compress downloads: it drops Content-Length.
			@compressible not path /api/instances/*/files/download*
			encode @compressible gzip

			# WebSockets (console + event streams) need no special handling.
			reverse_proxy 127.0.0.1:8730 {
				header_up X-MineManager-Proxy-Secret {$MM_PROXY_SECRET}
			}
		}
	}
}
