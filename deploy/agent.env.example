# Copy to /etc/minemanager/agent.env and edit. Referenced by the systemd unit.

# WebSocket URL of the hub (reachable over your WireGuard mesh).
MM_HUB_URL=ws://10.0.0.1:8730/ws/agent

# Where the agent stores its identity (node id + long-lived credential).
MM_AGENT_DATA_DIR=/var/lib/minemanager-agent

# tmux session name prefix for managed instances (optional).
MM_SESSION_PREFIX=mm

# ONE-TIME: paste the enrollment token from the hub UI here for the first start,
# then delete this line. After enrolling, the agent uses the saved credential.
# MM_ENROLL_TOKEN=paste-token-here
