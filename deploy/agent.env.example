# MineManager AGENT configuration (one per node)
# ---------------------------------------------------------------------------
# Installed to /etc/minemanager/agent.env by deploy/install.sh.
# The agent is the only MineManager daemon on a node: systemd supervises the
# agent, the agent supervises the servers. Do not add per-server units.
# ===========================================================================


# --- Essential -------------------------------------------------------------

# WebSocket URL of the hub. The agent always dials out.
MM_HUB_URL=wss://minemanager.internal/ws/agent

# Note: must be outside /home, the unit sets ProtectHome=true.
MM_AGENT_DATA_DIR=/var/lib/minemanager-agent

# ONE-TIME: paste the enrollment token from the hub, start once, then remove.
# A spent token left here is harmless; it is rejected and the saved credential is used.
#MM_ENROLL_TOKEN=paste-token-here


# ===========================================================================
# --- Advanced (all optional; defaults shown) -------------------------------
# ===========================================================================

# Accept a plaintext ws:// hub URL to a non-loopback host.
#MM_ALLOW_INSECURE=0

# tmux session prefix and socket. Together these identify a running server:
# sessions are `tmux -L <socket>` named `<prefix>-<instance_id>`.
#MM_SESSION_PREFIX=mm
#MM_TMUX_SOCKET=minemanager

# Ceiling on total uncompressed size when extracting an archive
#MM_MAX_EXTRACT_BYTES=21474836480

# Attach to a running console:
#   sudo -u minecraft tmux -L minemanager attach -t mm-<instance_id>
