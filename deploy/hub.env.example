# MineManager HUB configuration
# ---------------------------------------------------------------------------
# Copy to /etc/minemanager/hub.env, edit, then lock it down (systemd reads it as root):
#
#   sudo install -o root -g root -m 0600 hub.env.example /etc/minemanager/hub.env
# ===========================================================================


# --- Essential -------------------------------------------------------------

MM_DATA_DIR=/var/lib/minemanager

# Bind address. Keep it on loopback behind your reverse proxy + auth.
# A non-loopback bind requires MM_PROXY_SECRET.
MM_HOST=127.0.0.1
MM_PORT=8730

# Secret the proxy sends as X-MineManager-Proxy-Secret after authenticating
# (see deploy/Caddyfile). install.sh generates one; or: openssl rand -hex 32
MM_PROXY_SECRET=

# Hostnames this hub answers to, comma-separated (ports are ignored, list bare hostnames).
# REQUIRED for any deployment that is not purely loopback.
# Note: default is loopback only. Use "*" to disable the check (not recommended).
MM_ALLOWED_HOSTS=localhost,127.0.0.1


# ===========================================================================
# --- Advanced (all optional; defaults shown) -------------------------------
# ===========================================================================

# How long a one-time enrollment token stays valid, in seconds.
#MM_ENROLLMENT_TTL=900

# When a node's agent *starts*, start the instances marked "start with node"
# (set by Start/Stop, by a console stop, or by the toggle in Settings). This is
# what brings a rebooted box back on its own. A reconnect after a dropped link,
# or a hub restart, does not trigger it. Set to 0 to require an explicit Start
# every time. Never stops anything - only starts.
#MM_AUTOSTART=1

# Seconds to wait between consecutive autostarts on one node, so a box hosting
# several servers is not asked to load every world at once.
#MM_AUTOSTART_STAGGER=5

# Authenticated-user header to require and log (Authelia: Remote-User).
#MM_PROXY_USER_HEADER=Remote-User

# Allow a non-loopback MM_HOST without MM_PROXY_SECRET (unsafe).
#MM_ALLOW_UNAUTHENTICATED=0

# Allow state-changing requests (POST/PUT/PATCH/DELETE) that carry no Origin header
# Enable this if you want to build your own automations. (reads (GET) are unaffected.)
#MM_ALLOW_API_CLIENTS=0

# Serve the interactive API docs at /docs, /redoc and /openapi.json. Off by default.
#MM_ENABLE_DOCS=0

# Where the web UI is served from. The unit sets this to the installer's copy.
#MM_WEB_DIR=/opt/minemanager/web

# Extra allowed browser origins, comma-separated.
# For running the UI off a different origin during development
#MM_CORS_ORIGINS=

# File-editor guards, in bytes. Above WARN the UI asks before opening; above
# MAX it refuses to open the file as text at all (download it instead).
#MM_EDITOR_WARN_BYTES=2000000
#MM_EDITOR_MAX_BYTES=5000000

# Ceiling for the simple (base64) upload/download path, in bytes. Larger files
# use the streaming transfer instead.
#MM_TRANSFER_CAP_BYTES=8388608
